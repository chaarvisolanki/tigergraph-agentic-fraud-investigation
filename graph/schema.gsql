CREATE VERTEX Account (PRIMARY_ID account_id STRING, customer_id STRING, status STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Card (PRIMARY_ID card_id STRING, fingerprint STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Device (PRIMARY_ID device_id STRING, device_info STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Connection (PRIMARY_ID connection_id STRING, connection_type STRING, value_hash STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Transaction (PRIMARY_ID transaction_id STRING, transaction_dt DATETIME, transaction_amt DOUBLE, risk_score DOUBLE) WITH primary_id_as_attribute="true";
CREATE VERTEX Case (PRIMARY_ID case_id STRING, status STRING, risk_level STRING, confidence DOUBLE, outcome STRING, sar_required BOOL) WITH primary_id_as_attribute="true";
CREATE VERTEX Evidence (PRIMARY_ID evidence_id STRING, evidence_type STRING, summary STRING, strength DOUBLE, polarity STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX FraudPattern (PRIMARY_ID pattern_id STRING, name STRING, description STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX PolicyClause (PRIMARY_ID policy_id STRING, title STRING, text STRING, sar_required BOOL) WITH primary_id_as_attribute="true";
CREATE DIRECTED EDGE OWNS_CARD (FROM Account, TO Card);
CREATE DIRECTED EDGE INITIATED (FROM Account, TO Transaction, observed_at DATETIME);
CREATE DIRECTED EDGE USED_DEVICE (FROM Transaction, TO Device, observed_at DATETIME);
CREATE DIRECTED EDGE USES_DEVICE (FROM Account, TO Device, first_seen DATETIME, last_seen DATETIME);
CREATE DIRECTED EDGE CONNECTED_VIA (FROM Transaction, TO Connection);
CREATE DIRECTED EDGE ABOUT_ACCOUNT (FROM Case, TO Account);
CREATE DIRECTED EDGE ABOUT_TRANSACTION (FROM Case, TO Transaction);
CREATE DIRECTED EDGE HAS_EVIDENCE (FROM Case, TO Evidence, rank INT);
CREATE DIRECTED EDGE MATCHES_PATTERN (FROM Evidence, TO FraudPattern, match_score DOUBLE);
CREATE DIRECTED EDGE DERIVED_FROM_POLICY (FROM Evidence, TO PolicyClause, relevance DOUBLE);
CREATE DIRECTED EDGE SIMILAR_TO (FROM Case, TO Case, similarity DOUBLE);
